# n8n environment variables used by the workflows. Copy to .env next to your docker-compose.yml.
# Never commit the real .env.
GROQ_API_KEY=
GEMINI_API_KEY=
DISCORD_DIGEST_WEBHOOK_URL=
# Optional providers (only if you add them to outreach.llm.chain)
OPENROUTER_API_KEY=
# Code nodes read $env, so n8n must allow it
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

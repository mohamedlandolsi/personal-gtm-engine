# Neon > Connect > Pooled connection (host contains -pooler), Node.js snippet
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# 12+ characters, used only by you
DASHBOARD_PASSWORD=
# 32+ random characters (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=

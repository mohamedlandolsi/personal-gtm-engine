    {
      "id": "203f8632-3cc1-4af4-a526-c1f8e4709be5",
      "name": "Pack Sync Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        720
      ],
      "parameters": {
        "jsCode": "// Pack Sync Payload (Code node, mode: Run Once for All Items)\n// Turns the four Sheets reads into one typed JSON payload for gtm_sync_pull().\n// Sprint 12: outreach_queue lives in Neon only (outreach_sor = neon) and the digest is retired,\n// so those two tabs are no longer read. gtm_sync_pull() treats the missing keys as empty.\n// Deterministic gate: bad numbers or dates become null plus a warning, so one\n// messy cell can never abort the database write.\nconst safeAll = (name) => { try { return $(name).all().map(i => i.json); } catch (e) { return []; } };\nconst warnings = [];\nconst T = 'txt', I = 'int', N = 'num', D = 'ts';\n\nconst SPECS = {\n  accounts: { node: 'Read Accounts Tab', key: 'account_id', cols: {\n    account_id: T, run_date: D, source: T, company_name: T, domain: T, website: T, industry: T,\n    company_type: T, employee_count: I, location_raw: T, country: T, timezone_utc_offset: N,\n    funding_stage: T, final_score: I, priority: T, why_match: T, red_flags: T, score_breakdown: T,\n    confidence: I, status: T, linkedin_url: T, tech_stack: T, funding_proxy_score: I,\n    automation_need_score: I, enrichment_status: T, clay_summary: T, clay_status: T,\n    clay_enriched_at: D, contact_feasibility_score: I, contact_status: T,\n    clay_trigger: T, clay_trigger_source: T, clay_trigger_date: T } },\n  contacts: { node: 'Read Contacts Tab', key: 'contact_id', cols: {\n    contact_id: T, run_date: D, account_id: T, company_name: T, domain: T, full_name: T, title: T,\n    role_category: T, email: T, email_status: T, linkedin_url: T, phone: T, source: T,\n    confidence: I, contact_score: I, preferred_channel: T, status: T, contact_key: T, account_domain: T } },\n  ops: { node: 'Read Ops Tab', key: 'run_at', cols: {\n    run_at: D, config_rev: T, source: T, seed_rows: I, seen_rows_pre: I, after_filters: I,\n    accounts_written: I, min_account_score: I, warnings: T, errors_sample: T, rejection_summary: T,\n    apollo_companies: I, source_errors: T, enriched_rows: I, enrich_errors: T, clay_queued: I,\n    clay_merged: I, contacts_discovered: I, contacts_written: I, outreach_drafts_written: I,\n    llm_calls: I, llm_failures: I } }\n};\n\nconst ENUMS = {\n  approval_status: { allowed: ['pending', 'approved', 'edited', 'rejected', 'superseded'], fallback: 'pending' },\n  send_status: { allowed: ['not_sent', 'sent', 'bounced'], fallback: 'not_sent' }\n};\n\nconst blank = (v) => v === null || v === undefined || (typeof v === 'string' && v.trim() === '');\n\nfunction conv(type, v, ctx) {\n  if (blank(v)) return null;\n  if (type === T) return String(v);\n  if (type === I || type === N) {\n    const n = typeof v === 'number' ? v : Number(String(v).trim().replace(',', '.'));\n    if (!Number.isFinite(n)) { warnings.push(`not_a_number ${ctx}=${String(v).slice(0, 20)}`); return null; }\n    return type === I ? Math.round(n) : n;\n  }\n  if (type === D) {\n    const d = new Date(v);\n    if (isNaN(d.getTime())) { warnings.push(`bad_timestamp ${ctx}=${String(v).slice(0, 25)}`); return null; }\n    return d.toISOString();\n  }\n  return v;\n}\n\nconst payload = {};\nconst stats = {};\n\nfor (const [table, spec] of Object.entries(SPECS)) {\n  const rows = safeAll(spec.node);\n  const byKey = new Map();\n  let skipped = 0, dupes = 0;\n\n  for (const raw of rows) {\n    const rawKey = raw[spec.key];\n    const key = spec.cols[spec.key] === D\n      ? conv(D, rawKey, `${table}.${spec.key}`)\n      : (blank(rawKey) ? null : String(rawKey).trim());\n    if (!key || key.startsWith('__')) { skipped++; continue; }   // empty rows and __placeholder__ rows\n\n    const out = {};\n    for (const [col, type] of Object.entries(spec.cols)) {\n      out[col] = col === spec.key ? key : conv(type, raw[col], `${table}.${col}@${key}`);\n    }\n\n    if (table === 'outreach_queue') {\n      for (const [col, rule] of Object.entries(ENUMS)) {\n        const v = String(out[col] || '').trim().toLowerCase();\n        if (!rule.allowed.includes(v)) {\n          if (v) warnings.push(`bad_${col} ${key}=${v} -> ${rule.fallback}`);\n          out[col] = rule.fallback;\n        } else {\n          out[col] = v;\n        }\n      }\n    }\n\n    if (byKey.has(key)) dupes++;\n    byKey.set(key, out);                                           // last row wins\n  }\n\n  payload[table] = [...byKey.values()];\n  stats[table] = { read: rows.length, kept: byKey.size, skipped, dupes };\n  if (dupes) warnings.push(`${table}: ${dupes} duplicate keys in sheet, kept the last one`);\n}\n\n// Config cell (config!B2). Imported once, then only checked for drift.\nconst cfgRow = safeAll('Read Config Tab').find(r => String(r.key || '').trim() === 'config_json');\npayload.config_value = cfgRow ? String(cfgRow.value ?? '') : null;\n\n// What the push branches wrote to Sheets in this run. A branch that did not\n// run returns [], so its rows stay dirty and are pushed again next time.\nconst pushed = (node) => safeAll(node)\n  .filter(r => r && r.key && r.version)\n  .map(r => ({ key: String(r.key), version: String(r.version) }));\npayload.pushed = {\n  config: pushed('Only Config Push'),\n  contacts: pushed('Only Contact Push'),\n  accounts: pushed('Only Account Push')\n};\n\npayload.warnings = warnings.slice(0, 50);\n\nreturn [{ json: { payload, stats } }];\n",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    },

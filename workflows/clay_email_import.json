    {
      "id": "9a04d4b1-76b7-47e7-90a0-8db528152b56",
      "name": "Map Email Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Applies Clay email results to contacts. Never downgrades a verified email.\nconst safeAll = (n) => { try { return $(n).all().map(i => i.json); } catch (e) { return []; } };\n// Header match ignores case, spaces, underscores and prefixes (\"Contact Id\" == \"contact_id\")\nconst key = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst pick = (row, names) => {\n  for (const n of names) {\n    for (const k of Object.keys(row)) {\n      if (key(k.split('::').pop()) === key(n)) {\n        const v = row[k];\n        if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n      }\n    }\n  }\n  return '';\n};\nconst CONF = { verified: 100, guessed: 30, not_found: 0 };   // SPEC section 24\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i;\n\nconst contacts = {};\nfor (const c of safeAll('Read Contacts')) if (c && c.contact_id) contacts[String(c.contact_id).trim()] = c;\n\nconst stats = { export_rows: 0, found_verified: 0, guessed_confirmed: 0, guessed_invalid: 0,\n  guessed_unchanged: 0, not_found: 0, not_run: 0, already_verified: 0, unknown_contact: 0 };\nconst out = [];\n\nfor (const r of safeAll('Read Clay Email Export')) {\n  stats.export_rows++;\n  const id = pick(r, ['contact_id']);\n  const c = contacts[id];\n  if (!c) { stats.unknown_contact++; continue; }\n  const mode = pick(r, ['mode']).toLowerCase();\n  const result = pick(r, ['email_status_clay']).toLowerCase();\n  const found = pick(r, ['email_clay']).toLowerCase();\n  const oldEmail = String(c.email || '').trim().toLowerCase();\n  const oldStatus = String(c.email_status || '').toLowerCase() || 'not_found';\n\n  if (!result) { stats.not_run++; continue; }                       // leave queued, export again later\n  if (oldStatus === 'verified') { stats.already_verified++; continue; }\n\n  let email = oldEmail, status = oldStatus, channel = c.preferred_channel || 'linkedin_manual';\n  if (mode === 'find') {\n    if (result === 'verified' && EMAIL_RE.test(found)) {\n      email = found; status = 'verified'; channel = 'email'; stats.found_verified++;\n    } else { stats.not_found++; }\n  } else if (mode === 'verify') {\n    if (result === 'verified') { status = 'verified'; channel = 'email'; stats.guessed_confirmed++; }\n    else if (result === 'invalid') { email = ''; status = 'not_found'; channel = 'linkedin_manual'; stats.guessed_invalid++; }\n    else { stats.guessed_unchanged++; }                               // catch_all: keep it as guessed\n  }\n\n  const changed = email !== oldEmail || status !== oldStatus;\n  const oldScore = Number(c.contact_score) || 0;\n  const newScore = Math.max(0, Math.min(100,\n    Math.round(oldScore + 0.20 * ((CONF[status] ?? 0) - (CONF[oldStatus] ?? 0)))));\n  const src = String(c.source || '');\n\n  out.push({ json: {\n    contact_id: id,\n    changed,\n    queue_status: changed ? 'clay_done' : 'clay_no_change',\n    email,\n    email_status: status,\n    preferred_channel: channel,\n    contact_score: changed ? newScore : oldScore,\n    source: changed && !src.includes('+clay_email') ? src + '+clay_email' : src\n  } });\n}\n\n// Stats item has no contact_id, so the Filter drops it. Read it in this node's output.\nreturn out.concat([{ json: { __stats: JSON.stringify(stats) } }]);\n"
      }
    },
